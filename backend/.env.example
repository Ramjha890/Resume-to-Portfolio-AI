# Environment Configuration
PROJECT_NAME="AI Resume-to-Portfolio Generator"
SECRET_KEY="your-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (defaults to local SQLite file for instant local dev, or set PostgreSQL)
DATABASE_URL="sqlite:///./portfolio_app.db"
# Example PostgreSQL: postgresql://user:password@localhost:5432/portfolio_db

# Groq API for ultra-fast Llama-3 resume analysis and content generation
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Optional OpenAI or generic OpenAI-compatible API (e.g. Ollama, OpenRouter)
OPENAI_API_KEY=""
OPENAI_API_BASE=""
OPENAI_MODEL="gpt-4o-mini"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15
